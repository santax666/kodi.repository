<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.audio.pcradio" 
       name="PCRadio" 
       version="0.1.2" 
       provider-name="SantaX">
    
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
	<import addon="script.module.requests" version="0.0.0" />
    </requires>
    
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>audio</provides>
    </extension>
    
    <extension point="xbmc.addon.metadata">
        <summary lang="ru">Радио онлайн PCRADIO</summary>
        <description lang="ru">PCRADIО это лучшие онлайн радиостанции различных жанров, вещающих из множества стран мира.</description>
        <platform>all</platform>
	<source>https://pcradio.ru/</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>